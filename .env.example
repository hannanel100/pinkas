# Copy to .env.local and fill in. .env* is gitignored except this file.
#
# SDD §2.3 — three access paths, and the keys are what separate them. Read the
# comments before adding anything here; two of these values have very different
# blast radii.

# ── Supabase project ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The anon key. Safe to ship to the browser: it carries no permission to read
# bride tables, because RLS grants nothing without an authenticated JWT
# (SDD §13). That is a property of the policies, not of the key — if a table
# ever becomes readable with this key alone, the policy is the bug.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠ The service-role key BYPASSES RLS COMPLETELY.
#
# It is the one credential in the system that can read every tenant's data,
# including session_record. It must:
#   - never be prefixed NEXT_PUBLIC_ (that would ship it to the browser);
#   - be reachable only from lib/data/portal.ts (invariant 5, enforced by lint);
#   - never appear in a code path that accepts arbitrary user input.
# Treat a leak of this value as a full data breach — PRD §10.1.
SUPABASE_SERVICE_ROLE_KEY=
